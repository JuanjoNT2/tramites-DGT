# PostHog (espejo opcional; la fuente de verdad es /api/collect)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# GTM (espejo marketing; no sustituye al almacén propio)
PUBLIC_GTM_ID=

# Dominio canónico SEO (canonicals, sitemap, OG). Nunca uses *.vercel.app
PUBLIC_SITE_ORIGIN=https://tramitesdgtonline.com

# --- Supabase Auth + datos (proyecto gawfttwqyejunscftman) ---
# Public (cliente browser / SSR)
PUBLIC_SUPABASE_URL=https://gawfttwqyejunscftman.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Server (analytics + solicitudes + admin usuarios / gestor)
SUPABASE_URL=https://gawfttwqyejunscftman.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Verificación de email: SOLO SendGrid vía SMTP en Dashboard Supabase Auth
# (smtp.sendgrid.net, user=apikey, password=SG....). No usar Resend.

# Emails transaccionales de la app (solicitud recibida, pago confirmado, invitación)
# Misma API key de SendGrid; FROM debe estar verificado en SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@tramitesdgtonline.com

# Admin panel analítica — OBLIGATORIO en producción/preview:
# ADMIN_PASSWORD ≥12 chars (no "admin")
# ADMIN_SESSION_SECRET ≥32 chars aleatorios
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Stripe (pasarela preferida) ---
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → endpoint /api/pago/stripe-webhook
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Redsys (opcional; si no hay Stripe) ---
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=001
REDSYS_SECRET_KEY=
REDSYS_ENV=test

# Almacén propio (recomendado en producción)
# Sin esto, los eventos se guardan en .data/analytics/ (local/dev)
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY arriba cubren analytics y solicitudes.

# Carril B — agregados externos (opcional; tablas analytics_external_daily)
GSC_SITE_URL=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Legacy / opcional
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
GA4_CONVERSION_EVENTS=form_submitted,payment_started
GOOGLE_SERVICE_ACCOUNT_EMAIL=
