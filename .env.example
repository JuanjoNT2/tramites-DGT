# PostHog (CDP / product analytics) — page_view, CTAs y embudo
# Crea proyecto en https://eu.posthog.com (o US) y pega la Project API Key
# Sin key: los eventos van a localStorage `tdgt_events` + console.debug
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Taggeado: además se empujan a window.dataLayer (GTM/GA4)
# Inventario SEO: src/lib/analytics/event-declaration.json
# Fuente de verdad: src/lib/analytics/page-map.ts

# Google Tag Manager (sitio público)
PUBLIC_GTM_ID=

# Admin panel (/admin) — login sencillo
# Por defecto en local: password "admin" si no defines ADMIN_PASSWORD
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# GA4 Data API (panel en vivo; sin esto usa modo demo)
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=
# Eventos marcados como conversión (comma-separated)
GA4_CONVERSION_EVENTS=form_submitted,payment_started

# Search Console
GSC_SITE_URL=

# Google Ads (conector independiente; el link Ads↔GA4 en Google es opcional)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Meta Ads
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Opcional service account (futuro)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
